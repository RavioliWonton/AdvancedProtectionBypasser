<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths for InstallProxyActivity and for the APKs the module
  stages. The module (system_server) sends the intercepted session APK through
  ApkStageProvider, which copies it into cache/apks/; the installer then
  receives it via a content:// URI.
-->
<paths>
    <cache-path name="apks" path="apks/" />
</paths>
