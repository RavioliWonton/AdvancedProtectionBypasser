<resources>
    <!--
      Base theme for the activity before Compose takes over. Must descend from a
      Theme.AppCompat theme because MainActivity extends AppCompatActivity (for
      the per-app language APIs). DayNight follows the system light/dark setting.
    -->
    <style name="Theme.ABP" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!--
      Invisible theme for InstallProxyActivity. The proxy is a plain Activity
      (no Compose/AppCompat) and never draws any UI, so the platform translucent
      theme is enough.
    -->
    <style name="Theme.ABP.Transparent" parent="@android:style/Theme.Translucent.NoTitleBar" />
</resources>
