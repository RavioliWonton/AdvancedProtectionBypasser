<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      We query installed packages to build the app list and to read their
      requested permissions (REQUEST_INSTALL_PACKAGES).
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ABP">

        <!--
          The icon is intentionally hidden from the launcher: this activity has
          NO CATEGORY_LAUNCHER. Instead it declares the MODULE_SETTINGS category
          so the LSPosed manager can resolve and open it
          (AppHelper.getSettingsIntent -> ACTION_MAIN + MODULE_SETTINGS).
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!--
          Lets AndroidX AppCompat persist the per-app locale selected via the
          in-app language picker on Android 12 (API 32) and lower. On Android 13+
          the system stores it. android:enabled="false" keeps it as a metadata
          holder only (it is never actually started as a service).
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
          Required by libxposed:service. The manager calls into this provider
          (SEND_BINDER) to hand the module the XposedService binder so that
          XposedServiceHelper.OnServiceListener.onServiceBind is invoked and
          remote preferences / scope APIs become available.
        -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!--
          ACTION_INSTALL_PACKAGE proxy (Task 2-A). The module (in system_server)
          redirects a selected app's ACTION_INSTALL_PACKAGE intent to this
          invisible activity. It hands the APK to the configured installer via
          ACTION_VIEW and, when the caller set EXTRA_RETURN_RESULT, polls
          PackageManager and returns EXTRA_INSTALL_RESULT to the caller.

          theme: Theme.Translucent.NoTitleBar. NOT Theme.NoDisplay - that sets
          windowNoDisplay=true, which makes Activity.mVisibleFromClient false and
          Activity.performResume() then throws IllegalStateException for any app
          with targetSdk > 22 unless the activity finished before onResume().
          This proxy must stay alive until the install result is known.

          configChanges: the proxy must NOT be recreated while it waits for the
          install result, otherwise the flow would run twice (a second copy of
          the APK plus a second installer launch) and the caller would never
          receive a result.

          launchMode: intentionally left at the default (standard). singleTask /
          singleInstance would move the activity into its own task, which makes
          the system cancel the activity result the caller is waiting for, and
          singleTop would route a second install to onNewIntent() (not handled),
          silently dropping it. Standard mode keeps the proxy in the caller's
          task so setResult() reaches the caller through the resultTo chain; the
          extra instances are short-lived and independent.
        -->
        <activity
            android:name=".install.InstallProxyActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            tools:ignore="ExportedActivity" />

        <!--
          Serves the APKs the module stages (into cache/apks/) to the configured
          installer through a content:// URI + FLAG_GRANT_READ_URI_PERMISSION.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
